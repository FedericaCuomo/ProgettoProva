{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "arrowParens": "avoid",
  "printWidth": 80,
  "experimentalTernaries": true,
  "plugins": ["prettier-plugin-tailwindcss"],
  "endOfLine": "auto",
  "objectWrap": "preserve",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ]
}